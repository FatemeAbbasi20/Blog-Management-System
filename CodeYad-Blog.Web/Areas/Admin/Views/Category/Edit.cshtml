@model Codeyad_Blog.Web.Areas.Admin.Model.EditCategoryViewModel
@{ViewData["Title"] = "ویرایش دسته بندی ها";}
    <section class="content-header">
    <h1>
       @ViewData["Title"]
    </h1>
    <ol class="breadcrumb">
        <li><a asp-area="Admin" asp-controller="Home" asp-action="Index"><i class="fa fa-dashboard"></i> خانه</a></li>
        <li><a asp-area="Admin" asp-controller="Category" asp-action="Index">دسته بندی ها</a></li>
        <li class="active">@ViewData["title"]</li>
    </ol>
</section>

<section class="content">
    <form class="box box-danger" method="post" asp-area="admin" asp-controller="Category" asp-action="Edit">
        <div class="box box-row"></div>
        <div class="col-md-6">
            @Html.EditorFor(m => m.Title)
        </div>
        <div class="col-md-6">
            @Html.EditorFor(m => m.Slug)
        </div>
        <div class="col-md-6">
            @Html.EditorFor(m => m.MetaTag)
        </div>
        <div class="col-md-6">
            @Html.EditorFor(m => m.MetaDescription)
        </div>
        <div class="box-footer">
            <button class="btn btn-success" type="submit">ثبت اطلاعات</button>
        </div>

         
    </form>






</section>
