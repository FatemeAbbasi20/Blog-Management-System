@using CodeYad_Blog_CoreLayer.Utilities
@model BasePagination
@if (Model.PageCount > 1)
{
	<div style="padding:10px">
		<ul class="pagination"style="display:inline-block">
			@if (Model.CurrentPage > 1)
			{
				<li class="paginate_button previous ">
					<a href="javascript:void(0)" onclick="ChangePage(@(Model.CurrentPage-1))">قبلی</a>
				</li>
			}
			else
			{
				<li class="paginate_button previous disabled">
					<a href="javascript:void(0)">قبلی</a>
				</li>
			}
			@for (var i= Model.StartPage;i<=Model.EndPage;i++) 
		    {  
				<li class="paginate_button@(i==Model.CurrentPage?"active":null)">
					<a href="javascript:void(0)" onclick="ChangePage(@i)">@i</a></li>
			}
			@if (Model.PageCount > Model.CurrentPage)
			{
				<li class="paginate_button next">
					<a href="javascript:void(0)" onclick="ChangePage(@(Model.CurrentPage+1))">بعدی</a>
				</li>
			}
			else
			{
				<li class="paginate_button next disabled">
					<a href="javascript:void(0)">بعدی</a>
				</li>
			}
		</ul>
	</div>
	}